# Postgres connection string.
# If another project already publishes 5432 (or 9000 for S3 below), give this
# stack its own host ports in `.env` rather than here: docker compose reads
# `.env`, not `.env.local`. See "Port conflicts" in the README.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eecs_capstone

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-me-run-npx-better-auth-cli-secret

# The proxy hops between the viewer and the app, as a comma-separated list of
# IP or CIDR entries. Production sets the VPC range (Terraform var.vpc_cidr).
# Better Auth reads the viewer off X-Forwarded-For for rate limiting and
# session.ip_address, and the value has to be non-empty whatever it holds, so a
# production task refuses to boot without it. What it actually matches, and why
# that is not the whole story, is in the Better Auth section of docs/QUIRKS.md.
# Leave it blank locally: the dev server is reached directly, and rate limiting
# is off outside production.
TRUSTED_PROXY_CIDR=

# OAuth providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ONID sign-in, through the Oregon State Entra ID tenant.
# The discovery URL and client ID are public values and are safe to keep here.
# The secret is not: UIT issue it into the Azure Key Vault kv-engr-coe-vault-caps
# and it is copied by hand.
#
# There are TWO secrets on this one client ID. Use the development one here; the
# production one goes to AWS Secrets Manager and expires 2028-08-24. Renewal is a
# request through the UIT support portal.
#
# ONID_DISCOVERY_URL is not decoration. The tenant issuer is derived from it and
# every token is checked against that issuer, so an unset value makes ONID
# sign-in fail closed rather than accept tokens from any tenant.
#
# It must name the tenant by GUID, as below. Entra also resolves a discovery URL
# built on a domain name (oregonstate.edu, or the .onmicrosoft.com form), but the
# issuer claim in a token is always the GUID form, so a domain-shaped value here
# derives an issuer no token can match and every sign-in is refused.
#
# The localhost redirect URI http://localhost:3000/api/auth/oauth2/callback/onid
# is registered. See docs/ONID-SSO.md.
ONID_DISCOVERY_URL=https://login.microsoftonline.com/ce6d05e1-3c5e-4d62-87a8-4c4a2713c113/v2.0/.well-known/openid-configuration
ONID_CLIENT_ID=d551d87a-b608-46a6-9fc3-a8b6bd56a5df
ONID_CLIENT_SECRET=

# Email transport: 'console' (local) | 'ses' (AWS SES)
EMAIL_TRANSPORT=console
# Verified SES sender identity (required when EMAIL_TRANSPORT=ses)
EMAIL_FROM=
# Where replies go; leave blank to let replies land on EMAIL_FROM. Not part of
# DKIM alignment, so any address works, verified or not. Production uses
# eecs-capstone@oregonstate.edu (Terraform var.email_reply_to).
EMAIL_REPLY_TO=
# The one mailbox every email addressed to staff goes to (the "new project
# submitted" notice today). Distinct from EMAIL_REPLY_TO even though they hold
# the same address: one is where replies land, the other is who acts on what the
# app reports. Required when EMAIL_TRANSPORT=ses; under console, unset means
# staff email nobody and the app logs it.
EMAIL_STAFF_INBOX=
# SES region (defaults to AWS_REGION, then us-east-1). On ECS, credentials
# come from the task role, so no access keys are needed here.
SES_REGION=us-west-2

# Seed (used by scripts/seed-admin.ts, not by the app)
SEED_ADMIN_EMAIL=

# Object storage (RustFS locally, AWS S3 in prod).
# In production on ECS, leave S3_ENDPOINT and the keys unset: credentials are
# supplied by the task role via the SDK default provider chain.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cs-capstone
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin

# Client-facing base URL for storage keys.
# Local: http://localhost:9000/<bucket>
# Prod (AWS): the assets CloudFront distribution, supplied as a build arg by
# the deploy workflow. Not the bucket's own S3 URL: the bucket blocks public
# access and is read only through that distribution, so S3 answers 403.
VITE_STORAGE_PUBLIC_BASE=http://localhost:9000/cs-capstone

# The site's own origin, for the tags that are specified as absolute URLs and
# cannot use a relative path: og:image, twitter:image and rel=canonical (#498).
# A scraper fetching the page has no base to resolve a relative one against and
# drops the tag rather than guessing.
# Local: the dev server, which BETTER_AUTH_URL pins to port 3000.
# Prod (AWS): the public site origin, supplied as a build arg by the deploy
# workflow beside VITE_STORAGE_PUBLIC_BASE. Not BETTER_AUTH_URL, which holds
# the same value but is server-only, and these tags are built isomorphically.
VITE_SITE_URL=http://localhost:3000

# AWS Bedrock (AI project review).
# In production on ECS, leave the keys unset: credentials come from the task
# role. BEDROCK_REGION must point at a region that hosts BEDROCK_MODEL_ID.
#
# The review calls the Responses API on the bedrock-mantle endpoint, which
# exists in fewer regions than bedrock-runtime does: us-east-1, us-east-2,
# us-west-2, ap-northeast-1, ap-south-1, ap-southeast-2, ap-southeast-3,
# eu-central-1, eu-north-1, eu-south-1, eu-west-1, eu-west-2, and sa-east-1.
# Model ids on this endpoint carry no cross-region prefix; `us.` and `global.`
# profile ids belong to bedrock-runtime and are rejected here.
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=openai.gpt-5.6-luna
BEDROCK_ACCESS_KEY=
BEDROCK_SECRET_KEY=

# Reasoning budget for the review: none, low, medium, high, xhigh, or max.
# Reasoning tokens are billed as output and spend the same budget as the answer,
# so raising this costs money twice: directly, and by crowding out the tool call
# under max_output_tokens. Raise max_output_tokens with it, or a higher setting
# measures truncation rather than quality. Ignored by models that do not reason.
BEDROCK_REASONING_EFFORT=medium

# Reasoning effort for the staff scope assessment (#61), which is the opposite
# shape from the review: think hard, answer briefly. Its output ceiling is
# fixed in code, so raising this cannot starve the answer the way it can for
# the review.
BEDROCK_SCOPE_REASONING_EFFORT=high

# Reasoning effort for the social summary (#498). One of none, low, medium,
# high, xhigh, max: Mantle rejects the OpenAI value `minimal` with a 400, and
# shipping it is what broke this feature on 2026-09-21. The job is compressing
# three fields into one sentence a stranger reads in a chat client, and this is
# the only one of the three that runs unattended, on every publish, archive and
# edit of a live project.
BEDROCK_SOCIAL_SUMMARY_REASONING_EFFORT=medium

# Cap on sign-in codes mailed to ONE address, per recipient rather than per
# sender (#554, #576). It is the only way into the app without ONID or GitHub,
# so running out locks somebody out, and it is also the brute force control:
# Better Auth's three guesses per code reset on every resend, so what bounds
# guessing is how many codes an address can be sent. Five an hour covers a code
# that does not arrive, a second, and a third after mistyping the second, and
# still holds an attacker to fifteen guesses an hour against a six digit space.
VERIFICATION_MAIL_WINDOW_MINUTES=60
SIGN_IN_CODE_LIMIT=5

# Per-user ceiling on AI reviews. Reviews are the only paid, user-triggered
# call in the app, and the submission page can reach it without owning a
# project, so this is what bounds spend. Generous on purpose: the job is
# stopping a runaway, not budgeting.
AI_REVIEW_LIMIT_PER_HOUR=10
AI_REVIEW_LIMIT_PER_DAY=40

# The scope assessment's own pair. Staff-only and a different cost profile
# from the review, so the two are metered apart: exhausting one never blocks
# the other, and `ai_review_usage.feature` says which one a row was.
AI_SCOPE_LIMIT_PER_HOUR=10
AI_SCOPE_LIMIT_PER_DAY=40

# The social summary's own pair, and the loosest of the three. It meters only
# the staff Regenerate button: the automatic generation on publish and on edit
# has no user to attribute to and is not counted. A rewrite is one cheap
# sentence rather than a reasoning run, and staff working through a batch of
# projects before a term starts should not hit a ceiling built for the review.
AI_SOCIAL_SUMMARY_LIMIT_PER_HOUR=20
AI_SOCIAL_SUMMARY_LIMIT_PER_DAY=60

# Embedding model for interest-based project recommendations. Must be enabled
# for your account in the BEDROCK_REGION above (model access is granted in the
# Bedrock console, separately from IAM permissions).
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

# Kill switch. Set to false to make every embedding attempt fail instantly
# without calling AWS. The integration test suite sets this automatically.
BEDROCK_EMBEDDINGS_ENABLED=true

# The social summary's own kill switch. Set to false to skip every generation
# without calling AWS. It matters more than the embeddings one: the summary
# runs on every publish, archive and edit of a live project rather than behind
# a button, so leaving it on offline costs a credential-chain probe per save.
# The integration test suite sets this automatically.
#
# Both backfill sweepers under `scripts/` honour it too, and print one line and
# exit 0 rather than spending a catalog of model calls on summaries the app
# would not have generated. Anything but the exact string "false" is on, so an
# unset variable leaves generation enabled.
BEDROCK_SOCIAL_SUMMARY_ENABLED=true

# Where `scripts/import-legacy.mjs` reads the legacy portal's archive from.
# Set exactly one. Neither belongs in a deployed task definition: this is a
# one-time import, and the operator passes the value as a container override
# (see DEPLOYMENT.md section 7a).
#
# The data names 299 real proposers and their email addresses, so the S3
# prefix must be a PRIVATE bucket, never the app's asset bucket, whose every
# key is served to the world through CloudFront, and
# both objects should be deleted once the import is verified.
LEGACY_DATA_S3_URI=
# The ops bucket's region, when it differs from S3_REGION. GetObject against
# the wrong region fails with a redirect rather than a missing-key error, so
# guessing here produces an unhelpful crash.
LEGACY_DATA_S3_REGION=
# A local directory holding the same two files, for a dry run against a
# tunnelled database.
LEGACY_DATA_DIR=

# The file `scripts/import-legacy.mjs` reads the projects from, under the
# prefix or directory above. Defaults to archived-projects-clean.jsonl. Set it
# when importing a different set, such as the projects still live in the old
# portal, which are exported to their own filename so the two stay separable.
LEGACY_DATA_PROJECTS_FILE=

# How long a server keeps the project listing's filter options in memory, in
# milliseconds (#558, ADR-0048). 0 or unset is no cache, which is right for dev:
# the E2E and accessibility suites insert rows behind the running server and
# would read a stale list. Production sets 60000 in infra/ecs.tf.
REFERENCE_LIST_CACHE_TTL_MS=0
