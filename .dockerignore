# Dependencies and build artifacts are produced inside the image
node_modules
.output
.tanstack
.nitro

# VCS and CI. `.gitignore` stays: Tailwind v4 reads it to decide what not to
# scan, and without it the SSR pass scans `.output/` and hashes a stylesheet
# the client pass never wrote (#397).
.git
.github

# Secrets and local env (never bake into an image)
.env
.env.*
!.env.example

# Tests, reports, and editor/tooling state
test-results
playwright-report
.playwright-mcp
.vscode
.cta.json

# Docs and infra (not needed by the app build)
docs
infra
*.md

# Local-only compose stack
docker-compose.yml
