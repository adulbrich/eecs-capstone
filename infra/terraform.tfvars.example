# Copy to terraform.tfvars and fill in. Required values have no defaults.

github_owner = "your-org-or-user"
github_repo  = "cs-capstone"

# Where CloudWatch alarm mail goes. AWS sends a confirmation link on the first
# apply and the subscription delivers nothing until somebody clicks it.
alarm_email = "you@oregonstate.edu"

# Optional overrides:
# region           = "us-west-2"
# github_client_id = "Iv1.xxxxxxxx"
# bedrock_region   = "us-east-1"
# bedrock_model_id = "openai.gpt-5.6-luna"
# bedrock_reasoning_effort = "medium"
# ai_review_limit_per_hour = "10"
# ai_review_limit_per_day  = "40"
