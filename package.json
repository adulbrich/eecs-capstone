{
  "name": "cs-capstone",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "prepare": "lefthook install || true",
    "build": "vite build",
    "check:compression": "node scripts/check-compression.mjs",
    "check:prose": "node scripts/check-prose.mjs --all",
    "preview": "vite preview",
    "test": "vitest run --exclude '**/*.integration.test.ts' --exclude '**/*.a11y.test.ts' --exclude '**/*.e2e.test.ts'",
    "test:accessibility": "playwright test --config playwright.a11y.config.ts",
    "test:accessibility:smoke": "playwright test --config playwright.a11y.config.ts --grep @smoke",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test --config playwright.e2e.config.ts --global-timeout 1800000",
    "test:smoke": "playwright test --config playwright.e2e.config.ts --grep @smoke",
    "test:e2e:sweep": "tsx --env-file=.env.local scripts/sweep-e2e.ts",
    "format": "ultracite fix",
    "lint": "ultracite check",
    "check": "ultracite check",
    "typecheck": "tsc --noEmit",
    "start": "node .output/server/index.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:deploy": "node scripts/migrate.mjs",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "db:seed:dev": "tsx --env-file=.env.local scripts/seed-dev.ts",
    "db:seed:admin": "tsx --env-file=.env.local scripts/seed-admin.ts",
    "storage:init": "tsx --env-file=.env.local scripts/storage-init.ts",
    "embeddings:backfill": "tsx --env-file=.env.local scripts/backfill-embeddings.ts"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1121.0",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/client-sesv2": "^3.1121.0",
    "@aws-sdk/credential-provider-node": "^3.972.52",
    "@faker-js/faker": "^10.6.0",
    "@smithy/signature-v4": "^5.4.6",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/match-sorter-utils": "^8.19.4",
    "@tanstack/react-devtools": "^0.10.5",
    "@tanstack/react-form": "^1.32.0",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-query-devtools": "^5.100.10",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/react-router-ssr-query": "^1.166.12",
    "@tanstack/react-start": "^1.167.65",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.132.0",
    "better-auth": "~1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^1.38.0",
    "nitro": "npm:nitro-nightly@3.0.1-20260512-093145-0498ce70",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-image-crop": "^11.1.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "^0.7.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.3.1",
    "jsdom": "^30.0.1",
    "lefthook": "2.1.12",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "ultracite": "7.10.7",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "undici": ">=7.29.0 <8",
    "ws": ">=8.21.0",
    "esbuild": ">=0.28.1",
    "shell-quote": ">=1.9.0",
    "js-yaml": ">=4.3.1 <5",
    "brace-expansion": ">=5.0.7",
    "@babel/core": ">=7.29.6 <8",
    "launch-editor": ">=2.14.1",
    "nanoid": ">=3.3.17 <4",
    "postcss": ">=8.5.23 <9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
